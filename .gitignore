# ###########################################################################
# .gitignore — cloudwatch-agent
#
# Stack: Python 3.13 (uv) + Terraform + Docker + GitHub Actions, on macOS.
# Tracked ON PURPOSE (never add these here): uv.lock, .python-version,
# terraform/.terraform.lock.hcl, *.example files, .github/.
# ###########################################################################

# ###########################################################################
# Python
# ###########################################################################
__pycache__/
*.py[cod]

# Packaging artifacts — only appear if `uv build` is run; never committed.
build/
dist/
*.egg-info/

# ###########################################################################
# Virtual env & tool caches
# ###########################################################################
# uv creates .venv/ in-project. uv.lock IS committed for reproducibility.
.venv/
venv/

# ruff is the only configured dev tool (this project has no pytest/mypy).
.ruff_cache/

# ###########################################################################
# Terraform
# ###########################################################################
# Provider/module plugin cache.
.terraform/

# State must live in the configured S3 backend, never on disk.
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info

# Saved plan outputs — may embed sensitive resolved values.
*.tfplan
tfplan

# .tfvars may hold secrets / account IDs; *.tfvars.example stays tracked.
*.tfvars
*.tfvars.json

# Local-only resource overrides.
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Per-user CLI config (may contain credentials or machine paths).
.terraformrc
terraform.rc

# NOTE: terraform/.terraform.lock.hcl is intentionally committed.

# ###########################################################################
# Secrets & local environment
# ###########################################################################
.env
.env.*
!.env.example
*.pem
*.key

# Claude Code machine-specific settings (shared settings can be committed).
.claude/settings.local.json

# ###########################################################################
# Logs
# ###########################################################################
*.log

# ###########################################################################
# OS & editors (macOS / VS Code / JetBrains / vim)
# ###########################################################################
.DS_Store
._*
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~
